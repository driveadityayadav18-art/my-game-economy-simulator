# AI-Driven Game Economy Simulator - Environment Configuration Template

# LLM Provider Selection: openai | anthropic | gemini | simulated
LLM_PROVIDER=simulated

# Provider API Keys (leave empty or unset to operate in simulated heuristic fallback mode)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# LLM Model Names
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-3-5-haiku-20241022
GEMINI_MODEL=gemini-1.5-flash

# Economic Parameters
MARKET_SENSITIVITY_K=0.05
MARKET_PRICE_FLOOR=1.0
DEFAULT_TAX_RATE=0.10
MIN_TAX_RATE=0.0
MAX_TAX_RATE=0.80

# Simulation Timing & Latency Constraints
SIMULATION_TICK_INTERVAL_SECONDS=4.0
LLM_TIMEOUT_SECONDS=2.0
HOST=0.0.0.0
PORT=8000
